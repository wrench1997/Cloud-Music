# 网页版使用的 Web application OAuth Client ID。填入 .env.local 后重启或重新构建。
# Google Cloud 数据访问须同时配置 drive.readonly（目录和音乐）与 drive.file（应用曲库保存）。
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# 桌面版推荐在登录页导入 Google Cloud 下载的 Desktop app OAuth JSON。
# 也可在启动 Electron 的进程环境中设置以下变量；Next 不会把 .env.local 加载到 Electron 主进程。
# GOOGLE_DESKTOP_CLIENT_ID=
# GOOGLE_DESKTOP_CLIENT_SECRET=
