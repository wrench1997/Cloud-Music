{
  "name": "electron-nextjs-music",
  "version": "1.2.1",
  "description": "Desktop music player built with Electron, Next.js and SQLite",
  "main": "electron/main.js",
  "scripts": {
    "media:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-media-tools.ps1",
    "media:server": "node scripts/download-server.cjs --lan",
    "dev": "next dev",
    "preview": "node scripts/preview.cjs",
    "build": "next build",
    "start": "node scripts/preview.cjs",
    "web": "npm run build && npm start",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "electron:dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run icons && next build && electron-builder",
    "electron:start": "electron .",
    "android:sync": "npm run icons && next build && cap sync android",
    "android:open": "cap open android",
    "android:build": "npm run icons && next build && cap sync android && cd android && gradlew --init-script mirror-init.gradle assembleDebug",
    "android:build:ps": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\build-android.ps1",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\package-release.ps1",
    "icons": "node scripts/generate-icons.cjs",
    "lint": "next lint",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.1",
    "better-sqlite3": "^11.8.1",
    "electron-updater": "^6.7.3",
    "next": "15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@electron/rebuild": "^3.7.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.10",
    "postcss": "^8.5.1",
    "sharp": "0.33.5",
    "tailwindcss": "^3.4.17",
    "wait-on": "^8.0.2"
  },
  "build": {
    "extraResources": [
      {
        "from": ".local/media-tools",
        "to": "media-tools",
        "filter": [
          "yt-dlp.exe",
          "ffmpeg.exe",
          "ffprobe.exe",
          "node.exe"
        ]
      }
    ],
    "appId": "com.music.player",
    "productName": "Yungan Music",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/lib/google-config.js",
      "out/**/*",
      "public/icon.png",
      "public/icon.ico",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico",
      "artifactName": "Yungan-Music-Setup-${version}.${ext}",
      "signAndEditExecutable": true,
      "fileAssociations": [
        {
          "ext": [
            "mp3",
            "wav",
            "flac",
            "ogg",
            "m4a",
            "aac",
            "wma",
            "ape",
            "dsf",
            "dff",
            "aiff",
            "aif",
            "alac",
            "opus",
            "amr",
            "ac3",
            "dts",
            "tta"
          ],
          "name": "Audio File",
          "description": "Audio file",
          "role": "Viewer"
        }
      ]
    },
    "nsis": {
      "shortcutName": "云感音乐"
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "wrench1997",
        "repo": "Cloud-Music",
        "releaseType": "release"
      }
    ]
  }
}
